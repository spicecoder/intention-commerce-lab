# Real application URLs used by --mode real
ORDERS_API_URL=http://localhost:3001
INVENTORY_API_URL=http://localhost:8081

# Local Ollama defaults; no environment variables are required for these values.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# API-hosted OpenAI-compatible LLM. API_MODEL is required for --client api.
API_BASE_URL=https://api.moonshot.ai/v1
API_MODEL=
API_KEY=
# MOONSHOT_API_KEY and OPENAI_API_KEY are also accepted.

LLM_TIMEOUT_SECONDS=120

# Optional Inventory fault injection for real-service experiments.
INVENTORY_FAILURE_MODE=none
INVENTORY_FAILURE_DELAY_MS=7000
