{
  "schemaVersion": "intention-commerce-runtime/0.1",
  "spaceId": "IS_CommerceReference",
  "universeId": "U01",
  "colosseumId": "C04",
  "description": "Executable first milestone: order draft, submission, stock reservation, and order decision.",
  "resolutionPulse": "resolution",
  "dns": {
    "DN_OrdersDraft": {
      "implementation": "orders",
      "input": {
        "signal": "S_CreateDraft",
        "intention": "I_OrderDraftRequested",
        "requiredPulses": ["customer_id", "sku", "quantity"]
      },
      "output": {
        "signal": "S_DraftReady",
        "intention": "I_OrderDraftCreated",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address"]
      }
    },
    "DN_OrdersSubmit": {
      "implementation": "orders",
      "input": {
        "signal": "S_SubmitOrder",
        "intention": "I_OrderSubmissionRequested",
        "requiredPulses": ["order_id"]
      },
      "output": {
        "signal": "S_ReservationRequested",
        "intention": "I_StockReservationRequested",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address"]
      }
    },
    "DN_InventoryReserve": {
      "implementation": "inventory",
      "input": {
        "signal": "S_ReservationRequested",
        "intention": "I_StockReservationRequested",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address"]
      },
      "output": {
        "signal": "S_ReservationDecision",
        "intention": "I_StockReservationDecided",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address", "reservation_id", "reservation_status", "failure_reason"]
      }
    },
    "DN_OrdersDecide": {
      "implementation": "orders",
      "input": {
        "signal": "S_ReservationDecision",
        "intention": "I_StockReservationDecided",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address", "reservation_id", "reservation_status", "failure_reason"]
      },
      "output": {
        "signal": "S_OrderDecision",
        "intention": "I_OrderAcceptanceDecided",
        "requiredPulses": ["order_id", "customer_id", "sku", "quantity", "unit_price_cents", "total_cents", "currency", "shipping_address", "reservation_id", "reservation_status", "failure_reason", "order_status"]
      }
    }
  }
}
